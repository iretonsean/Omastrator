# Maintainer: Sean Ireton <1441621+iretonsean@users.noreply.github.com>
pkgname=omastrator-bin
pkgver=0.0.0
pkgrel=1
pkgdesc="Vector illustration for Linux, made for Omarchy (prebuilt binary)"
arch=('x86_64' 'aarch64')
url="https://github.com/iretonsean/Omastrator"
license=('MIT')
depends=('qt6-base' 'jq' 'shared-mime-info' 'hicolor-icon-theme' 'desktop-file-utils')
# See omastrator-git's PKGBUILD for what each of these is for; voxtype and omdrop/omadrop
# aren't pacman packages, so `omastrator setup` names how to install them instead.
optdepends=('hyprpicker: Capture > Pick Colour as a Swatch'
            'slurp: Capture > Screenshot Region, selecting the region'
            'grim: Capture > Screenshot Region and Screenshot Window'
            'wl-clipboard: Capture > paste from the clipboard'
            'rclone: Cloud storage (open and save on a cloud remote)'
            'python-gobject: Design mode reading a native app window (AT-SPI)'
            'at-spi2-core: Design mode reading a native app window (AT-SPI)'
            'chromium: Live web editing, and Design mode in a Chromium tab'
            'github-cli: Deploy shows its GitHub history'
            'qt6-imageformats: placing TIFF and WebP images')
provides=('omastrator')
conflicts=('omastrator' 'omastrator-git')
install=omastrator.install
source_x86_64=("https://github.com/iretonsean/Omastrator/releases/download/v${pkgver}/omastrator-${pkgver}-x86_64.tar.zst")
source_aarch64=("https://github.com/iretonsean/Omastrator/releases/download/v${pkgver}/omastrator-${pkgver}-aarch64.tar.zst")
# Filled in by scripts/update-bin-pkgbuild.sh from the release's own SHA256SUMS.txt.
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    cp -a usr "$pkgdir/usr"
}
