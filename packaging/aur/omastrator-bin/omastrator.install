post_install() {
    echo ':: Run `omastrator setup` to wire up design mode and the tray light in'
    echo '   omarchy-shell, the Hyprland keys, the Omarchy menu entries and the'
    echo '   Chromium extension. It shows every change first and asks before'
    echo '   making it.'
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo ':: If you ran `omastrator setup`, run `omastrator setup --remove` first'
    echo '   to undo the shell plugins, keys, menu entries and Chromium extension.'
}
