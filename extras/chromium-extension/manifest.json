{
  "manifest_version": 3,
  "name": "Omastrator",
  "version": "1.0",
  "description": "Live in your own Chromium: Omastrator's editing overlay on the tab you choose, and Inspect inside pages. Installed by omastrator setup.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["debugger", "nativeMessaging", "scripting", "sidePanel", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Omastrator Live" },
  "side_panel": { "default_path": "panel.html" },
  "icons": { "16": "app-icon-16.png", "32": "app-icon-32.png", "128": "app-icon-128.png" },
  "background": { "service_worker": "background-2.js" }
}
